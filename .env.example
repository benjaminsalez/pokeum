# Example environment variables for local development. Copy this file to `.env`
# and fill in real values; `.env` is gitignored and never committed.
#
# The app reads configuration from the process environment through
# app/core/config.py — see openwiki/workflow.md. How you load these is your
# choice: export them in your shell, set them in your run configuration, or add
# a loader such as python-dotenv. Every key below is optional; the app runs
# with sensible defaults.

# Logging: `debug` shows everything our code does, `info` only milestones.
LOG_LEVEL=info

# `true` emits one-line JSON log records (handy for log shippers).
LOG_JSON=false

# --- Reference data & artifacts --------------------------------------------
# Root directory for the local reference store, image cache, and index
# artifacts. Gitignored; created on first `sync`.
DATA_DIR=./data

# TCGdex REST API base (free, no key). Fallback: https://api.pokemontcg.io/v2
# (different response shape — not a drop-in).
TCGDEX_BASE_URL=https://api.tcgdex.net/v2

# Card language to sync and recognize. The reference data and OCR are built for
# this language; `en` is the only fully supported value today.
CARD_LANGUAGE=en

# Path to an exported ONNX image encoder. The default is the fine-tuned
# DINOv2-small (photography-invariance training; see openwiki/training.md).
# When the file is absent, recognition falls back to the built-in pure-numpy
# HistogramEmbedder, so the system still runs — just far less robust to glare
# and extreme angles.
EMBED_MODEL_PATH=./data/models/dinov2s-ft-v1.onnx

# --- API service ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Webcam -----------------------------------------------------------------
# OpenCV capture device index for `pokeum scan`.
WEBCAM_INDEX=0
